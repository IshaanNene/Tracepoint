{
  "version": 1,
  "db": {
    "driver": "postgres",
    "dsn": "${PG_DSN}",
    "executor": {
      "rate": 20
    },
    "queries": [
      {
        "name": "probe",
        "type": "read",
        "sql": "SELECT 1"
      }
    ]
  },
  "redis": {
    "addr": "127.0.0.1:6379",
    "executor": {
      "rate": 50
    },
    "commands": [
      {
        "name": "ping",
        "cmd": [
          "PING"
        ]
      }
    ]
  }
}
